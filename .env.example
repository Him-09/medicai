# MedicAI Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# =============================================================================
# DATABASE
# =============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=medicai
POSTGRES_USER=postgres
PGPASSWORD=your-secure-password-here

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================

# JWT Secret - MUST be at least 32 characters
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=your-32-char-minimum-secret-key-here-change-this

# Access token expiration in minutes (default: 30)
ACCESS_TOKEN_MINUTES=30

# MFA Enforcement (true/false) - RECOMMENDED: true for production
MFA_REQUIRED=true

# =============================================================================
# FILE ENCRYPTION
# =============================================================================

# File encryption key (32 bytes, base64 encoded)
# Generate with: python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
FILE_ENCRYPTION_KEY=your-base64-encoded-32-byte-key-here

# =============================================================================
# BACKUP ENCRYPTION
# =============================================================================

# Backup encryption passphrase (use a strong, unique passphrase)
BACKUP_ENCRYPTION_KEY=your-very-strong-backup-passphrase-here

# Backup retention in days
BACKUP_RETENTION_DAYS=30

# Backup directory (default: ./backups)
BACKUP_DIR=./backups

# =============================================================================
# MULTI-TENANCY
# =============================================================================

# Default clinic ID for single-tenant deployments
DEFAULT_CLINIC_ID=00000000-0000-0000-0000-000000000001

# =============================================================================
# CORS & ALLOWED ORIGINS
# =============================================================================

# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# =============================================================================
# AI / OpenAI
# =============================================================================

OPENAI_API_KEY=sk-your-openai-api-key-here

# AI toggle (true/false) - disable AI features if needed
AI_ENABLED=true

# =============================================================================
# GOOGLE CLOUD (for Document AI)
# =============================================================================

# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GOOGLE_CLOUD_PROJECT=your-project-id

# =============================================================================
# LIVEKIT (for Voice features)
# =============================================================================

# LIVEKIT_URL=wss://your-livekit-server
# LIVEKIT_API_KEY=your-livekit-api-key
# LIVEKIT_API_SECRET=your-livekit-api-secret

# =============================================================================
# LOGGING
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# =============================================================================
# SECURITY NOTES
# =============================================================================
# 
# 1. JWT_SECRET: Keep this secret! If compromised, rotate immediately.
#    All existing tokens will be invalidated when changed.
#
# 2. FILE_ENCRYPTION_KEY: Store this securely! If lost, encrypted files
#    cannot be recovered. Consider using a key management service (KMS)
#    in production.
#
# 3. BACKUP_ENCRYPTION_KEY: Keep this separate from other keys.
#    Store in a secure location (not in the same backup!).
#
# 4. For production:
#    - Use HTTPS/TLS (configure in reverse proxy like nginx)
#    - Enable MFA_REQUIRED=true
#    - Set secure ALLOWED_ORIGINS
#    - Use strong, unique passwords for database
#    - Regular security audits and penetration testing
#
