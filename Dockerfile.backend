# ============================================================
#  MedicAI Backend — Multi-stage Dockerfile
# ============================================================

# ---- Build Stage ----
FROM python:3.11-slim AS builder

WORKDIR /app

# System deps for building C-extension wheels (psycopg, bcrypt, etc.)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

# ---- Runtime Stage ----
FROM python:3.11-slim

WORKDIR /app

# Runtime system dependencies
#   libpq5        — PostgreSQL client lib (psycopg)
#   poppler-utils — pdf2image (pdftotext / pdftoppm)
#   tesseract-ocr — pytesseract OCR
#   tesseract-ocr-fra — French language pack
#   libgl1 + libglib2.0 — OpenCV headless
#   curl          — health-check probe
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev \
    poppler-utils \
    tesseract-ocr \
    tesseract-ocr-fra \
    libgl1 \
    libglib2.0-0 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy pre-built Python packages from builder
COPY --from=builder /install /usr/local

# Copy application source
COPY setup.py .
COPY src/ src/
COPY app/ app/
COPY agent/ agent/
COPY migrations/ migrations/
COPY run_all_migrations.py .
COPY run_migration.py .

# Create data directories
RUN mkdir -p data/raw data/processed data/embeddings data/exports

# Install the medicai package itself
RUN pip install --no-cache-dir -e .

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# 2 workers is a good default for a 2-4 vCPU droplet
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
