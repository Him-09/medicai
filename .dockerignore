# ── Version control ──
.git
.gitignore

# ── Python artifacts ──
__pycache__
*.pyc
*.pyo
*.egg-info
.pytest_cache
.ruff_cache
.mypy_cache

# ── Virtual environments ──
.venv
venv
env

